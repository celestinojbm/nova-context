{
  "name": "nova-context",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "dev": "turbo run dev",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @nova/api db:migrate",
    "validate:pr": "pnpm --filter @nova/validation-gate gate pr",
    "validate:predeploy": "pnpm --filter @nova/validation-gate gate predeploy",
    "validate:deploy": "pnpm --filter @nova/validation-gate gate deploy",
    "validate:postdeploy": "pnpm --filter @nova/validation-gate gate postdeploy",
    "validate:recovery": "pnpm --filter @nova/validation-gate gate recovery",
    "validate:recovery-remote": "pnpm --filter @nova/validation-gate recovery-remote --"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.3.4",
      "@fastify/busboy": ">=3.2.2 <4",
      "adm-zip": ">=0.6.1 <0.7",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@5": ">=5.0.12 <6",
      "browserslist": ">=4.28.7 <5",
      "fast-uri@3": ">=3.1.8 <4",
      "find-my-way": ">=9.7.0 <10",
      "nanoid@3": ">=3.3.18 <4",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "sharp": ">=0.35.5 <0.36",
      "shell-quote": ">=1.9.0 <2",
      "source-map-js": ">=1.2.2 <2",
      "tar": ">=7.5.21 <8",
      "tmp": ">=0.2.6 <0.3",
      "vite@6": ">=6.4.4 <7"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "spawn-sync"
    ]
  }
}
